<div id="<%= dom_id post %>">
  <div>
    <strong>Title:</strong>
    <%= post.title %>
  </div>

  <div>
    <strong>Author:</strong>
    <%= post.author %>
  </div>

  <div>
    <strong>Rank:</strong>
    <%= post.rank %>
  </div>

  <div>
    <strong>Descrption:</strong>
    <%= post.descrption %>
  </div>

  <div>
    <strong>Text:</strong>
    <%= post.text %>
  </div>

</div>
